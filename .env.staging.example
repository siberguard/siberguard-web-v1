# =====================================================================
# Staging di Vercel — daftar Environment Variables
# Isi di: Vercel → Project → Settings → Environment Variables
# Environment "Preview", branch `development` saja. Production Branch Vercel tetap `main`
# dan tidak di-build (vercel.json → ignoreCommand). Lihat docs/deployment-staging-vercel.md.
# File ini hanya referensi. JANGAN commit nilai asli.
# =====================================================================

# ----- Wajib -----
# MongoDB Atlas → Connect → Drivers. Sertakan nama database setelah host.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soc-merdeka-staging?retryWrites=true&w=majority
# openssl rand -hex 32 (berbeda dari produksi)
PAYLOAD_SECRET=
ANALYTICS_HASH_PEPPER=
# Domain staging tetap yang dihubungkan ke branch `development` (Settings → Domains),
# tanpa garis miring di akhir. Bukan URL acak per deployment.
# Dibaca saat build: redeploy bila diubah.
NEXT_PUBLIC_SERVER_URL=https://siberguard-staging.vercel.app

# Media di Cloudinary (Vercel tidak punya disk permanen).
# Cloudinary → Settings → API Keys → "API environment variable".
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=soc-merdeka-staging

# Staging tidak diindeks Google (robots.txt + header X-Robots-Tag). Dibaca saat build.
SITE_NOINDEX=true

# ----- Email: MATI di staging -----
# Jangan isi RESEND_API_KEY maupun SMTP_HOST. Lead tetap tersimpan dengan status email
# "skipped"; notifikasi, balasan otomatis, dan lupa password tidak mengirim email.

# ----- Opsional -----
# Cloudflare Turnstile (site key dibaca saat build).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
APP_VERSION=staging
