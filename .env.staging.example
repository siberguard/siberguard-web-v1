# =====================================================================
# Staging di Vercel — daftar Environment Variables
# Isi di: Vercel → Project → Settings → Environment Variables
# (centang environment "Production" untuk project staging; lihat docs/deployment-staging-vercel.md)
# File ini hanya referensi. JANGAN commit nilai asli.
# =====================================================================

# ----- Wajib -----
# MongoDB Atlas → Connect → Drivers. Sertakan nama database setelah host.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soc-merdeka-staging?retryWrites=true&w=majority
# openssl rand -hex 32 (berbeda dari produksi)
PAYLOAD_SECRET=
ANALYTICS_HASH_PEPPER=
# URL staging tetap (domain Vercel atau subdomain sendiri), tanpa garis miring di akhir.
# Dibaca saat build: redeploy bila diubah.
NEXT_PUBLIC_SERVER_URL=https://soc-merdeka-staging.vercel.app

# Dibuat otomatis oleh Vercel saat Blob store dihubungkan ke project (Storage → Blob).
# Tanpa ini upload media gagal karena Vercel tidak punya disk permanen.
BLOB_READ_WRITE_TOKEN=

# Staging tidak diindeks Google (robots.txt + header X-Robots-Tag). Dibaca saat build.
SITE_NOINDEX=true

# ----- Email (opsional di staging) -----
# Kosongkan RESEND_API_KEY bila belum perlu: lead tetap tersimpan, status email "skipped".
RESEND_API_KEY=
# Harus dari domain yang sudah diverifikasi di Resend. Untuk uji cepat tanpa domain:
# onboarding@resend.dev (hanya bisa mengirim ke email pemilik akun Resend).
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME="SiberGuard (Staging)"
# Semua email staging dialihkan ke alamat ini (notifikasi lead, balasan otomatis, reset password).
EMAIL_OVERRIDE_TO=

# ----- Opsional -----
# Cloudflare Turnstile (site key dibaca saat build).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
APP_VERSION=staging
