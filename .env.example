# --- Wajib ---
# replicaSet=rs0 mengaktifkan transaksi, sama seperti produksi
DATABASE_URL=mongodb://127.0.0.1:27017/soc-merdeka?replicaSet=rs0
# Buat dengan: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email ---
# Penyedia dipilih otomatis: RESEND_API_KEY → SMTP_HOST → tanpa email (lead tetap tersimpan).
# Development memakai Mailpit (docker-compose.dev.yml).
RESEND_API_KEY=
# Khusus Resend: alihkan semua email ke satu alamat uji (staging)
EMAIL_OVERRIDE_TO=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=noreply@socmerdeka.id
EMAIL_FROM_NAME="SOC Merdeka"

# --- Seed: akun admin pertama ---
SEED_ADMIN_EMAIL=admin@socmerdeka.local
SEED_ADMIN_PASSWORD=

# --- Analytics ---
# Buat dengan: openssl rand -hex 32
ANALYTICS_HASH_PEPPER=
GEOIP_DB_PATH=
TRUST_PROXY=false

# --- Anti-spam (opsional, Cloudflare Turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
