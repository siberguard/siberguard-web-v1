# ===== Domain & URL =====
SITE_DOMAIN=socmerdeka.id
ACME_EMAIL=admin@socmerdeka.id
NEXT_PUBLIC_SERVER_URL=https://socmerdeka.id

# ===== Rahasia aplikasi (buat dengan: openssl rand -hex 32) =====
PAYLOAD_SECRET=
ANALYTICS_HASH_PEPPER=

# ===== MongoDB =====
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=socmerdeka
MONGO_APP_PASSWORD=

# ===== Email (SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@socmerdeka.id
EMAIL_FROM_NAME="SOC Merdeka"

# ===== Akun admin pertama (dipakai oleh "pnpm seed") =====
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_NOTIFY_EMAIL=halo@socmerdeka.id

# ===== Opsional =====
# Cloudflare Turnstile (anti-spam). Site key dibaca saat build — rebuild bila diubah.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# MaxMind GeoLite2 (akun gratis) untuk data kota/negara; aktifkan --profile geoip
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
BACKUP_KEEP_DAYS=14
APP_VERSION=1.0.0
